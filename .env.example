# Copy to .env (or just run `bash install.sh` / `npm run setup`).
# Everything is optional: without keys the app runs in practice mode.
# Free-tier walkthrough: docs/SETUP-GUIDE.md

PORT=3000

# Public address of this app, used in client onboarding, payment and unsubscribe links.
PUBLIC_URL=http://localhost:3000

# Real leads from Google Business listings (Google Places API "New").
GOOGLE_PLACES_API_KEY=
# Stop searching after this many Google calls per month (1000 = Google's free amount).
GOOGLE_MONTHLY_LIMIT=1000

# Email drip: Brevo (free 300/day) OR Resend (free 100/day, 3,000/month).
BREVO_API_KEY=
RESEND_API_KEY=

# GoHighLevel: the one button builds each client's sub-account from your template.
# Agency → Settings → Private Integrations (key starts with pit-). Needs the Agency Pro plan.
GHL_API_KEY=
GHL_COMPANY_ID=
# Optional. You can pick the template inside the app instead (Manager → 🚀 Launch).
GHL_SNAPSHOT_ID=

# Retell: builds the client's AI receptionist + buys a local number (key starts with key_).
RETELL_API_KEY=
# RETELL_VOICE_ID=retell-Cimo

# Optional: AI-written call openers from Google reviews (uses Claude).
ANTHROPIC_API_KEY=
# AI_OPENER_MONTHLY_LIMIT=1000

# Optional: off-server nightly backups to a Google Cloud Storage bucket
# (works automatically on a Google Cloud VM with Storage read/write access).
BACKUP_BUCKET=

# Google Place Details lookups per month (1000 = Google's free amount).
# GOOGLE_DETAILS_MONTHLY_LIMIT=1000

# Stripe: payment link for the setup fee + monthly plan on every close.
STRIPE_SECRET_KEY=
# Stripe webhook (endpoint: <PUBLIC_URL>/api/hooks/stripe, event: checkout.session.completed)
# Instant rep payouts also need Stripe Connect turned on in your Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Where to send new deals for automatic provisioning (Make / Zapier / n8n / GoHighLevel).
SETUP_WEBHOOK_URL=
# Signs outgoing webhooks and protects /api/hooks/provisioning (setup generates one).
WEBHOOK_SECRET=

# DATA_FILE=./data/salesboard.db
