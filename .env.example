# Copy this file to .env and fill in what you have. Everything is optional:
# without keys the app runs in demo mode so the team can practice.

PORT=3000

# Public address of this app, used in client onboarding + payment links.
PUBLIC_URL=http://localhost:3000

# Real leads from Google Business listings (Google Places API "New").
# console.cloud.google.com → enable "Places API (New)" → Credentials → API key
GOOGLE_PLACES_API_KEY=

# Stripe: creates a payment link for the setup fee + monthly plan on every close.
STRIPE_SECRET_KEY=
# Stripe webhook (endpoint: <PUBLIC_URL>/api/hooks/stripe, event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Where to send new deals for automatic provisioning (Zapier / Make / n8n / GoHighLevel).
# Can also be set in Manager → Settings.
SETUP_WEBHOOK_URL=
# Signs outgoing webhooks (X-SalesBoard-Signature) and protects /api/hooks/provisioning.
WEBHOOK_SECRET=

# Where data is stored (JSON file).
# DATA_FILE=./data/db.json
